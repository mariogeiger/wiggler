#!/usr/bin/env bash
# Linux validates the real recorder and chunk codec, not iOS or ARKit.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
artifacts=$(mktemp -d)
trap 'rm -rf "$artifacts"' EXIT
image=swift@sha256:9f82fca7d577f78772c1ef0c38392f9bee05d92c8483f903005cded067ded5ee
memcap -h 4G -m 5G -s 0 docker run --rm --memory=4g --memory-swap=4g --cpus=2 \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$root:/src:ro" -v "$artifacts:/test" -w /src "$image" \
    bash -lc 'set -euo pipefail
        swiftc -O -enable-testing -emit-library -emit-module -module-name WigglerCore \
            $(find WigglerCore/Sources/WigglerCore -name "*.swift" -print | sort) -o /test/libWigglerCore.so -emit-module-path /test/WigglerCore.swiftmodule
        swiftc -O -I /test -I tools/tests/recorder/CZlib -L /test -lWigglerCore -Xlinker -rpath -Xlinker /test \
            Wiggler/SessionRecorder.swift Wiggler/RecordingFrameMetadata.swift Wiggler/RecordingChunkCodec.swift tools/tests/recorder/*.swift -o /test/recorder-test
        /test/recorder-test /test/recordings
        /test/recorder-test /test/compressed --compressible
        swiftc -frontend -parse Wiggler/*.swift'
cd "$root"
PYTHONDONTWRITEBYTECODE=1 uv run --no-project --with numpy python tools/tests/verify_recorder.py "$artifacts/recordings"
PYTHONDONTWRITEBYTECODE=1 uv run --no-project --with numpy python tools/tests/verify_recorder.py "$artifacts/compressed"
PYTHONDONTWRITEBYTECODE=1 uv run --no-project --with numpy python -m unittest discover -s tools/tests
